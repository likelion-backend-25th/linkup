<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.likelion.bebc25.linkup.subscription.mapper.SubscriptionMapper">

    <sql id="subscriptionColumns">
        id, creator_id, member_id, customer_uid, price, start_date, end_date, status, next_billing_at
    </sql>

    <select id="findAll" resultType="net.likelion.bebc25.linkup.subscription.dto.SubscriptionResponse">
        SELECT <include refid="subscriptionColumns" />
        FROM subscription
    </select>

    <select id="findByCreatorId" parameterType="long" resultType="net.likelion.bebc25.linkup.subscription.dto.SubscriptionResponse">
        SELECT <include refid="subscriptionColumns" />
        FROM subscription
        WHERE creator_id = #{creatorId}
    </select>

</mapper>